<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0">
<title>Anchor — you are not alone</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500;1,9..144,600&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<style>
:root{
  --bg-0:#1D1930;
  --bg-1:#251F3D;
  --bg-2:#2E2749;
  --bg-3:#382F58;
  --glow:#F0B86E;
  --glow-dim:#B8895A;
  --rose:#E0949F;
  --mint:#83B8A6;
  --ink:#F4F0EA;
  --ink-soft:#A79FC2;
  --ink-faint:#726A8F;
  --border:rgba(255,255,255,0.07);
  --border-2:rgba(255,255,255,0.12);
  --r-lg:26px;
  --r-md:18px;
  --r-sm:12px;
}
*{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
html,body{margin:0; padding:0; height:100%;}
body{
  font-family:'Inter',sans-serif;
  background: var(--bg-0);
  color: var(--ink);
  overflow:hidden;
}
@media (prefers-reduced-motion: reduce){ *{animation-duration:0.01ms !important; transition-duration:0.01ms !important;} }
.serif{ font-family:'Fraunces', serif; }
.serif-i{ font-family:'Fraunces', serif; font-style:italic; }
.mono{ font-family:'JetBrains Mono', monospace; }
button{ font-family:inherit; }
input:focus, button:focus-visible, textarea:focus{ outline:2px solid var(--glow); outline-offset:2px; }

#app{
  max-width:460px; margin:0 auto; height:100vh; height:100dvh;
  position:relative; background:var(--bg-0); display:flex; flex-direction:column;
  overflow:hidden;
}

/* ambient aurora backdrop */
.aurora{ position:absolute; inset:0; overflow:hidden; z-index:0; pointer-events:none; }
.aurora span{ position:absolute; border-radius:50%; filter:blur(60px); opacity:0.35; animation: drift 18s ease-in-out infinite alternate; }
.aurora .a1{ width:260px; height:260px; background:var(--rose); top:-60px; left:-60px; }
.aurora .a2{ width:220px; height:220px; background:var(--mint); bottom:10%; right:-70px; animation-delay:-6s; }
.aurora .a3{ width:180px; height:180px; background:var(--glow); top:40%; left:60%; animation-delay:-12s; opacity:0.18;}
@keyframes drift{ from{ transform:translate(0,0) scale(1);} to{ transform:translate(24px,-18px) scale(1.15);} }

.screen{ position:relative; z-index:1; flex:1; overflow-y:auto; padding:26px 20px 106px 20px; display:none; }
.screen.active{ display:block; animation:riseIn .4s cubic-bezier(.2,.8,.2,1); }
@keyframes riseIn{ from{opacity:0; transform:translateY(10px);} to{opacity:1; transform:translateY(0);} }

.eyebrow{ font-size:12px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:var(--ink-faint); }
.h1{ font-size:30px; font-weight:600; margin:4px 0 24px 0; letter-spacing:-0.01em; }
.h2{ font-size:22px; font-weight:600; margin:0 0 4px 0; }
.sub{ color:var(--ink-soft); font-size:13.5px; margin:0 0 20px 0; line-height:1.5; }

.glass{
  background: linear-gradient(160deg, var(--bg-2), var(--bg-1));
  border:1px solid var(--border);
  border-radius: var(--r-lg);
  padding:20px;
  margin-bottom:14px;
}
.section-label{ font-size:13px; font-weight:700; color:var(--ink); margin:26px 0 12px 0; display:flex; justify-content:space-between; align-items:baseline; }
.mini-link{ font-size:12px; font-weight:600; color:var(--glow); background:none; border:none; cursor:pointer; }

/* ---- lamp glow signature ---- */
.lamp-wrap{ position:relative; width:216px; height:216px; margin:6px auto 0 auto; }
.lamp-halo{
  position:absolute; inset:14px; border-radius:50%;
  background: radial-gradient(circle, var(--glow-dim) 0%, transparent 68%);
  animation: breatheGlow 6s ease-in-out infinite;
  filter:blur(6px);
}
@keyframes breatheGlow{ 0%,100%{opacity:0.35; transform:scale(0.94);} 50%{opacity:0.7; transform:scale(1.05);} }
.lamp-svg{ width:100%; height:100%; transform:rotate(-90deg); position:relative; z-index:1;}
.lamp-track{ fill:none; stroke:var(--bg-3); stroke-width:12; }
.lamp-progress{ fill:none; stroke:var(--glow); stroke-width:12; stroke-linecap:round; transition:stroke-dashoffset 0.7s cubic-bezier(.4,0,.2,1); filter: drop-shadow(0 0 8px rgba(240,184,110,0.55)); }
.lamp-center{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:2;}
.lamp-num{ font-size:36px; font-weight:700; font-family:'JetBrains Mono'; }
.lamp-label{ font-size:11.5px; color:var(--ink-soft); font-weight:600; margin-top:4px; }

.stat-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:22px; }
.stat-pill{ background:var(--bg-2); border:1px solid var(--border); border-radius:16px; padding:12px 6px; text-align:center; }
.stat-pill .n{ font-family:'JetBrains Mono'; font-size:16px; font-weight:700; color:var(--glow); }
.stat-pill .l{ font-size:9.5px; color:var(--ink-faint); font-weight:700; letter-spacing:0.03em; text-transform:uppercase; margin-top:3px; }

.qa-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:20px; }
.qa-btn{
  border:1px solid var(--border); background:var(--bg-2); border-radius:18px; padding:14px 4px;
  display:flex; flex-direction:column; align-items:center; gap:8px; cursor:pointer; color:var(--ink);
  transition: transform 0.15s ease, background 0.15s ease;
}
.qa-btn:active{ transform:scale(0.94); }
.qa-btn .ic{ width:22px; height:22px; }
.qa-btn span{ font-size:10.5px; font-weight:700; }

.badge-strip{ display:flex; gap:10px; overflow-x:auto; padding:2px 2px 6px 2px; }
.badge-chip{ min-width:74px; background:var(--bg-2); border:1px solid var(--border); border-radius:16px; padding:12px 6px; text-align:center; flex-shrink:0; }
.badge-chip.locked{ opacity:0.3; filter:grayscale(0.6); }
.badge-chip .ic{ font-size:22px; }
.badge-chip .nm{ font-size:9.5px; font-weight:700; margin-top:5px; line-height:1.2; }

.affirm-card{ text-align:center; padding:26px 18px; position:relative; }
.affirm-card p{ font-size:17px; font-weight:500; line-height:1.5; margin:0; }
.bookmark-btn{ position:absolute; top:14px; right:14px; background:none; border:none; cursor:pointer; font-size:18px; opacity:0.5; }
.bookmark-btn.saved{ opacity:1; }

.btn-glow{ background:linear-gradient(135deg, var(--glow), var(--glow-dim)); color:#241A0C; border:none; border-radius:16px; padding:15px 20px; font-weight:700; font-size:14px; cursor:pointer; width:100%; }
.btn-glow:disabled{ opacity:0.35; cursor:not-allowed; }
.btn-outline{ background:none; border:1.5px solid var(--border-2); color:var(--ink); border-radius:16px; padding:13px 20px; font-weight:600; font-size:13px; cursor:pointer; width:100%; }
textarea, input[type=text], input[type=date]{
  width:100%; background:var(--bg-1); border:1px solid var(--border-2); border-radius:14px; color:var(--ink);
  padding:14px; font-family:'Inter'; font-size:14px; resize:none;
}

/* ---- sub nav pills (Calm / Journal) ---- */
.subnav{ display:flex; gap:8px; margin-bottom:22px; }
.subnav button{ flex:1; border:1px solid var(--border-2); background:transparent; color:var(--ink-soft); border-radius:14px; padding:10px 6px; font-size:12px; font-weight:700; cursor:pointer; }
.subnav button.active{ background:var(--glow); color:#241A0C; border-color:var(--glow); }
.subpage{ display:none; } .subpage.active{ display:block; animation: riseIn .3s ease; }

/* ---- breathe ---- */
.orb-wrap{ width:220px; height:220px; display:flex; align-items:center; justify-content:center; margin:10px auto 26px auto; position:relative; }
.orb-halo{ position:absolute; inset:0; border-radius:50%; background:radial-gradient(circle, var(--glow-dim), transparent 70%); filter:blur(10px); opacity:0.5; }
.orb{ width:128px; height:128px; border-radius:50%; background:radial-gradient(circle at 35% 30%, var(--glow), var(--glow-dim)); display:flex; align-items:center; justify-content:center; transition:transform 4s ease-in-out; position:relative; z-index:1; box-shadow:0 0 40px rgba(240,184,110,0.35); }
.orb-label{ color:#241A0C; font-weight:700; font-size:14px; font-family:'Fraunces'; }
.pace-row{ display:flex; gap:8px; justify-content:center; margin-bottom:8px; flex-wrap:wrap; }
.pace-chip{ border:1px solid var(--border-2); background:var(--bg-2); border-radius:20px; padding:8px 13px; font-size:11.5px; font-weight:700; cursor:pointer; color:var(--ink-soft); }
.pace-chip.active{ background:var(--glow); color:#241A0C; border-color:var(--glow); }

/* ---- grounding ---- */
.ground-step{ text-align:center; padding:34px 20px; }
.ground-step .num{ font-family:'JetBrains Mono'; font-size:44px; color:var(--glow); font-weight:700; }
.ground-step h3{ margin:10px 0 6px 0; }
.ground-list{ text-align:left; margin-top:18px; }
.ground-list textarea{ margin-bottom:8px; min-height:44px; }

/* ---- sounds ---- */
.sound-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:12px; margin-top:6px; }
.sound-card{ border:1px solid var(--border); background:var(--bg-2); border-radius:18px; padding:18px 10px; text-align:center; cursor:pointer; }
.sound-card.playing{ border-color:var(--glow); background:var(--bg-3); }
.sound-card .ic{ font-size:26px; }
.sound-card .nm{ font-size:12px; font-weight:700; margin-top:6px; }
.vol-row{ display:flex; align-items:center; gap:10px; margin-top:18px; }
.vol-row input{ flex:1; accent-color:var(--glow); }

/* ---- vent ---- */
#ventTextarea{ min-height:160px; }
.vent-canvas-wrap{ position:relative; }
.vent-fade{ transition: opacity 1.1s ease, transform 1.1s ease, filter 1.1s ease; }

/* ---- gratitude jar ---- */
.jar-shape{ width:150px; height:170px; margin:0 auto 14px auto; position:relative; }
.jar-items{ display:flex; flex-direction:column; gap:8px; margin-top:16px; }
.jar-item{ background:var(--bg-2); border:1px solid var(--border); border-radius:12px; padding:10px 14px; font-size:13px; }
.jar-reveal{ text-align:center; padding:22px; }

/* ---- letters ---- */
.letter-card{ background:var(--bg-2); border:1px solid var(--border); border-radius:16px; padding:16px; margin-bottom:10px; }
.letter-card .meta{ font-size:11px; color:var(--ink-faint); font-weight:700; margin-bottom:6px; }
.letter-card.locked{ opacity:0.7; }
.letter-card.ready{ border-color:var(--glow); }

/* ---- mood ---- */
.mood-row{ display:flex; gap:8px; }
.mood-btn{ flex:1; background:var(--bg-2); border:1.5px solid var(--border); border-radius:16px; padding:14px 4px; text-align:center; cursor:pointer; font-size:22px; }
.mood-btn.selected{ border-color:var(--glow); background:var(--bg-3); }

/* ---- chart ---- */
.chart-wrap{ display:flex; align-items:flex-end; gap:8px; height:100px; margin-top:14px; }
.chart-bar{ flex:1; background:linear-gradient(180deg, var(--glow), var(--glow-dim)); border-radius:6px 6px 3px 3px; min-height:4px; position:relative; }
.chart-labels{ display:flex; gap:8px; margin-top:6px; }
.chart-labels span{ flex:1; text-align:center; font-size:9.5px; color:var(--ink-faint); font-weight:700; }

.reflect-card p{ font-size:14.5px; line-height:1.6; margin:0; }

.toggle-row{ display:flex; align-items:center; justify-content:space-between; padding:14px 0; border-bottom:1px solid var(--border); }
.toggle-row:last-child{ border-bottom:none; }
.toggle{ width:44px; height:26px; border-radius:20px; background:var(--bg-3); position:relative; cursor:pointer; border:1px solid var(--border-2); flex-shrink:0; }
.toggle.on{ background:var(--glow); }
.toggle .knob{ width:20px; height:20px; border-radius:50%; background:var(--ink); position:absolute; top:2px; left:2px; transition:left 0.2s ease; }
.toggle.on .knob{ left:20px; background:#241A0C; }

.crisis-note{ margin-top:24px; padding:16px; border-radius:16px; background:var(--bg-2); border:1px solid var(--border); font-size:12.5px; color:var(--ink-soft); line-height:1.6; }
.crisis-note a{ color:var(--glow); font-weight:700; text-decoration:none; }

.badge-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
.badge-card{ background:var(--bg-2); border:1px solid var(--border); border-radius:16px; padding:14px 6px; text-align:center; }
.badge-card.locked{ opacity:0.3; filter:grayscale(0.6); }
.badge-card .ic{ font-size:24px; }
.badge-card .nm{ font-size:10px; font-weight:700; margin-top:6px; line-height:1.2; }
.badge-card .cd{ font-size:8.5px; color:var(--ink-faint); margin-top:2px; }

/* ---- nav bar ---- */
.navbar{ position:absolute; bottom:0; left:0; right:0; max-width:460px; margin:0 auto; background:var(--bg-1); border-top:1px solid var(--border); display:flex; padding:8px 4px calc(8px + env(safe-area-inset-bottom)); z-index:10; }
.nav-btn{ flex:1; background:none; border:none; cursor:pointer; display:flex; flex-direction:column; align-items:center; gap:3px; color:var(--ink-faint); padding:6px 2px; border-radius:14px; font-size:10px; font-weight:700; }
.nav-btn svg{ width:20px; height:20px; stroke:var(--ink-faint); }
.nav-btn.active{ color:var(--glow); background:var(--bg-2); }
.nav-btn.active svg{ stroke:var(--glow); }

.toast{ position:absolute; bottom:90px; left:50%; transform:translateX(-50%); background:var(--bg-3); border:1px solid var(--border-2); color:var(--ink); padding:11px 18px; border-radius:30px; font-size:12.5px; font-weight:600; opacity:0; pointer-events:none; transition:opacity 0.3s ease, transform 0.3s ease; z-index:30; white-space:nowrap; }
.toast.show{ opacity:1; transform:translateX(-50%) translateY(-6px); }

/* ---- onboarding ---- */
#onboard{ position:absolute; inset:0; z-index:50; background:var(--bg-0); display:flex; flex-direction:column; justify-content:center; padding:32px; text-align:center; }
#onboard .lamp-mini{ width:64px; height:64px; border-radius:50%; background:radial-gradient(circle at 35% 30%, var(--glow), var(--glow-dim)); margin:0 auto 24px auto; box-shadow:0 0 40px rgba(240,184,110,0.4); }
#onboard input{ margin-top:20px; text-align:center; font-size:16px; }
</style>
</head>
<body>
<div id="app">
  <div class="aurora"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>

  <!-- ONBOARDING -->
  <div id="onboard">
    <div id="onboardStep1">
      <div class="lamp-mini"></div>
      <h1 class="serif" style="font-size:26px; margin:0;">Welcome to Anchor</h1>
      <p class="sub" style="margin-top:10px;">A quiet place to check in with yourself. What should we call you?</p>
      <input type="text" id="onboardName" placeholder="Your name" maxlength="20">
      <button class="btn-glow" style="margin-top:22px;" onclick="goOnboardStep2()">Continue</button>
    </div>
    <div id="onboardStep2" style="display:none;">
      <h1 class="serif" style="font-size:24px; margin:0;">What brought you here?</h1>
      <p class="sub" style="margin-top:10px;">Pick whatever fits — this just helps us show you the right things first. You can pick more than one.</p>
      <div id="onboardReasons" style="display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin-top:18px;">
        <button class="pace-chip" data-reason="stress" onclick="toggleReason(this)">Stress</button>
        <button class="pace-chip" data-reason="loneliness" onclick="toggleReason(this)">Loneliness</button>
        <button class="pace-chip" data-reason="sleep" onclick="toggleReason(this)">Sleep trouble</button>
        <button class="pace-chip" data-reason="anxiety" onclick="toggleReason(this)">Anxiety</button>
        <button class="pace-chip" data-reason="low_mood" onclick="toggleReason(this)">Low mood</button>
        <button class="pace-chip" data-reason="just_curious" onclick="toggleReason(this)">Just curious</button>
      </div>
      <button class="btn-glow" style="margin-top:26px;" onclick="finishOnboarding()">Begin</button>
    </div>
  </div>

  <!-- ===================== HOME ===================== -->
  <div class="screen active" id="screen-home">
    <div class="eyebrow" id="greetTime">Good morning</div>
    <h1 class="h1" id="greetName">Hi, friend</h1>

    <div class="lamp-wrap">
      <div class="lamp-halo"></div>
      <svg class="lamp-svg" viewBox="0 0 220 220">
        <circle class="lamp-track" cx="110" cy="110" r="94"></circle>
        <circle class="lamp-progress" id="lampProgress" cx="110" cy="110" r="94" stroke-dasharray="590" stroke-dashoffset="590"></circle>
      </svg>
      <div class="lamp-center">
        <div class="lamp-num" id="stepsToday">0</div>
        <div class="lamp-label">of <span id="stepsGoalLabel">6000</span> steps</div>
      </div>
    </div>
    <div style="text-align:center; margin-top:10px;" id="manualStepHint">
      <button class="mini-link" onclick="logSteps()">+ log a short walk</button>
    </div>
    <div style="text-align:center; margin-top:6px; display:none;" id="autoStepHint">
      <span class="sub" style="margin:0;">🚶 Steps are tracking automatically</span>
    </div>

    <div class="stat-grid">
      <div class="stat-pill"><div class="n" id="streakCount">0</div><div class="l">Streak</div></div>
      <div class="stat-pill"><div class="n" id="coinCount">0</div><div class="l">Coins</div></div>
      <div class="stat-pill"><div class="n" id="waterCountHome">0/8</div><div class="l">Water</div></div>
      <div class="stat-pill"><div class="n" id="badgeCountHome">0/14</div><div class="l">Badges</div></div>
    </div>

    <div class="qa-grid">
      <button class="qa-btn" onclick="goTo('calm','breathe')"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="var(--glow)" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="3"></circle></svg><span>Breathe</span></button>
      <button class="qa-btn" onclick="goTo('journal','vent')"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="2" stroke-linecap="round"><path d="M12 20l9-9-9-9-9 9z"></path></svg><span>Vent</span></button>
      <button class="qa-btn" onclick="goTo('home','scratch')"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="var(--glow)" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"></circle><path d="M9 12l2 2 4-4"></path></svg><span>Scratch</span></button>
      <button class="qa-btn" onclick="goTo('calm','ground')"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="var(--mint)" stroke-width="2" stroke-linecap="round"><path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8"></path></svg><span>Ground</span></button>
    </div>

    <div class="section-label">Your badges <button class="mini-link" onclick="goTo('progress')">See all</button></div>
    <div class="badge-strip" id="homeBadgeStrip"></div>

    <div class="section-label">A reminder</div>
    <div class="glass affirm-card">
      <button class="bookmark-btn" id="bookmarkBtn" onclick="toggleBookmark()">♡</button>
      <p class="serif-i" id="affirmationText">You don't have to have it all figured out today.</p>
    </div>

    <div class="glass" style="text-align:center; padding:16px 18px;">
      <p class="sub" style="margin:0;" id="communityStatText">You're not the only one here right now — others are opening their scratch card and taking a breath today too.</p>
    </div>
  </div>

  <!-- ===================== HOME/SCRATCH (kept simple, own screen id) ===================== -->
  <div class="screen" id="screen-home-scratch">
    <div class="eyebrow">Once a day</div>
    <h1 class="h1">Scratch card</h1>
    <div class="glass" style="padding:0; overflow:hidden; position:relative; aspect-ratio:4/3;">
      <div style="position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:20px; text-align:center;">
        <div style="font-size:32px; margin-bottom:8px;">🪙</div>
        <p class="serif" style="font-size:16px; font-weight:600; margin:0;" id="scratchMessage">You showed up today. That counts.</p>
      </div>
      <canvas id="scratchCanvas" style="position:absolute; inset:0; touch-action:none;"></canvas>
    </div>
    <div class="sub" id="scratchHint" style="text-align:center;">Rub the card with your finger to reveal today's message</div>
    <div class="sub" id="scratchDoneMsg" style="display:none; text-align:center;">You've already opened today's card — come back tomorrow 🌙</div>
  </div>

  <!-- ===================== CALM ===================== -->
  <div class="screen" id="screen-calm">
    <div class="eyebrow">Calm space</div>
    <h1 class="h1">Just breathe</h1>
    <div class="subnav">
      <button class="active" data-sub="breathe" onclick="setCalmTab('breathe')">Breathe</button>
      <button data-sub="ground" onclick="setCalmTab('ground')">Ground</button>
      <button data-sub="sounds" onclick="setCalmTab('sounds')">Sounds</button>
    </div>

    <div class="subpage active" id="calm-breathe">
      <div class="pace-row">
        <button class="pace-chip active" data-pace="box" onclick="setPace('box')">Box</button>
        <button class="pace-chip" data-pace="478" onclick="setPace('478')">4-7-8</button>
        <button class="pace-chip" data-pace="deep" onclick="setPace('deep')">Slow &amp; deep</button>
      </div>
      <div class="orb-wrap"><div class="orb-halo"></div><div class="orb" id="breatheOrb"><span class="orb-label" id="breatheOrbLabel">Ready</span></div></div>
      <div class="sub" style="text-align:center;" id="breatheTimer">0:00 breathed today</div>
      <button class="btn-glow" id="breatheToggleBtn" onclick="toggleBreathing()">Start</button>
    </div>

