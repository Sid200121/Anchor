/* ============ BREATHE ============ */
const PACES = { box:{inhale:4,hold:4,exhale:4,holdOut:4}, '478':{inhale:4,hold:7,exhale:8,holdOut:0}, deep:{inhale:5,hold:0,exhale:6,holdOut:0} };
let currentPace='box', breathing=false, breatheTimerInterval=null, breatheSeconds=0, breathePhaseTimeout=null;
function setPace(p){ currentPace=p; document.querySelectorAll('.pace-chip').forEach(c=>c.classList.toggle('active', c.dataset.pace===p)); }
function toggleBreathing(){
  breathing=!breathing;
  const btn=document.getElementById('breatheToggleBtn'), orb=document.getElementById('breatheOrb');
  if(breathing){ btn.textContent='Stop'; runBreathCycle();
    breatheTimerInterval=setInterval(()=>{ breatheSeconds++; const m=Math.floor(breatheSeconds/60), s=breatheSeconds%60; document.getElementById('breatheTimer').textContent=`${m}:${s.toString().padStart(2,'0')} breathed today`; },1000);
  } else {
    btn.textContent='Start'; clearTimeout(breathePhaseTimeout); clearInterval(breatheTimerInterval);
    orb.style.transform='scale(1)'; document.getElementById('breatheOrbLabel').textContent='Ready';
    if(breatheSeconds>5){ unlockBadge('first_breath'); state.breathSessions++; if(state.breathSessions>=5) unlockBadge('five_breaths'); saveState(); checkBadges(); incrementCommunityStat('breath_sessions'); }
  }
}
function runBreathCycle(){
  if(!breathing) return;
  const pace=PACES[currentPace], orb=document.getElementById('breatheOrb'), label=document.getElementById('breatheOrbLabel');
  label.textContent='Inhale'; orb.style.transition=`transform ${pace.inhale}s ease-in-out`; orb.style.transform='scale(1.35)';
  breathePhaseTimeout=setTimeout(()=>{
    if(!breathing) return;
    if(pace.hold>0){ label.textContent='Hold'; breathePhaseTimeout=setTimeout(()=>{ if(breathing) exhalePhase(); }, pace.hold*1000); } else exhalePhase();
  }, pace.inhale*1000);
  function exhalePhase(){
    label.textContent='Exhale'; orb.style.transition=`transform ${pace.exhale}s ease-in-out`; orb.style.transform='scale(1)';
    breathePhaseTimeout=setTimeout(()=>{
      if(!breathing) return;
      if(pace.holdOut>0){ label.textContent='Hold'; breathePhaseTimeout=setTimeout(()=>{ if(breathing) runBreathCycle(); }, pace.holdOut*1000); } else runBreathCycle();
    }, pace.exhale*1000);
  }
}

