/* ============ PROGRESS ============ */
function lastNDays(n){
  const arr=[];
  for(let i=n-1;i>=0;i--){ arr.push(new Date(Date.now()-i*86400000).toISOString().slice(0,10)); }
  return arr;
}
function renderProgress(){
  const days = lastNDays(7);
  const moodChart=document.getElementById('moodChart'), moodLabels=document.getElementById('moodChartLabels');
  moodChart.innerHTML=''; moodLabels.innerHTML='';
  days.forEach(d=>{
    const v = state.moods[d]||0;
    const bar=document.createElement('div'); bar.className='chart-bar'; bar.style.height = v? (v*18+8)+'px':'4px';
    moodChart.appendChild(bar);
    const lab=document.createElement('span'); lab.textContent = new Date(d).toLocaleDateString(undefined,{weekday:'narrow'});
    moodLabels.appendChild(lab);
  });
  const stepsChart=document.getElementById('stepsChart'), stepsLabels=document.getElementById('stepsChartLabels');
  stepsChart.innerHTML=''; stepsLabels.innerHTML='';
  const maxSteps = Math.max(state.goalSteps, ...days.map(d=>state.steps[d]||0));
  days.forEach(d=>{
    const v = state.steps[d]||0;
    const bar=document.createElement('div'); bar.className='chart-bar'; bar.style.height = v? Math.max(4,(v/maxSteps)*90)+'px':'4px';
    stepsChart.appendChild(bar);
    const lab=document.createElement('span'); lab.textContent = new Date(d).toLocaleDateString(undefined,{weekday:'narrow'});
    stepsLabels.appendChild(lab);
  });

  const moodVals = days.map(d=>state.moods[d]).filter(Boolean);
  const avgMood = moodVals.length ? (moodVals.reduce((a,b)=>a+b,0)/moodVals.length).toFixed(1) : null;
  const totalSteps = days.reduce((a,d)=>a+(state.steps[d]||0),0);
  const goalDays = days.filter(d=>(state.steps[d]||0)>=state.goalSteps).length;
  let text = `You've kept a ${state.streak}-day streak going`;
  if(avgMood) text += ` with an average mood of ${avgMood}/5`;
  text += `. You walked ${totalSteps.toLocaleString()} steps this week`;
  if(goalDays>0) text += ` and hit your goal on ${goalDays} of them`;
  text += `. ${state.gratitude.length>0 ? 'Your gratitude jar has '+state.gratitude.length+' things in it. ' : ''}Keep going, one day at a time.`;
  document.getElementById('reflectionText').textContent = text;

  const grid=document.getElementById('badgeGridFull'); grid.innerHTML='';
  BADGES.forEach(b=>{
    const unlocked = state.unlockedBadges.includes(b.id);
    const d=document.createElement('div'); d.className='badge-card'+(unlocked?'':' locked');
    d.innerHTML = `<div class="ic">${b.icon}</div><div class="nm">${b.name}</div><div class="cd">${b.cond}</div>`
      + (unlocked ? `<button class="mini-link" style="margin-top:6px; padding:0;" onclick="shareBadge('${b.id}')">Share</button>` : '');
    grid.appendChild(d);
  });
}

