if(state.onboarded){ document.getElementById('onboard').style.display = 'none'; }

/* ============ NAV ============ */
function goTo(screen, sub){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  const id = screen==='home' && sub==='scratch' ? 'home-scratch' : screen;
  document.getElementById('screen-'+id).classList.add('active');
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.toggle('active', b.dataset.screen===screen));
  if(screen==='home' && sub!=='scratch') renderHome();
  if(id==='home-scratch') renderScratch();
  if(screen==='journal') renderJournal();
  if(screen==='progress') renderProgress();
  if(screen==='you') renderYou();
  if(screen==='calm' && sub) setCalmTab(sub);
}
function showToast(msg){ const t=document.getElementById('toast'); t.textContent=msg; t.classList.add('show'); setTimeout(()=>t.classList.remove('show'),2200); }

/* ============ STREAK ============ */
function checkStreak(){
  const today = todayKey();
  if(state.lastActiveDate === today) return;
  const yesterday = new Date(Date.now()-86400000).toISOString().slice(0,10);
  state.streak = (state.lastActiveDate === yesterday) ? state.streak+1 : 1;
  state.lastActiveDate = today;
  saveState();
}

/* ============ BADGES ============ */
function unlockBadge(id){
  if(state.unlockedBadges.includes(id)) return;
  state.unlockedBadges.push(id); saveState();
  showToast('🎉 New badge: ' + BADGES.find(x=>x.id===id).name);
}
function checkBadges(){
  const goalHits = Object.values(state.steps).filter(v=>v>=state.goalSteps).length;
  if(goalHits>=1) unlockBadge('goal_hit');
  if(goalHits>=5) unlockBadge('goal_hit_5');
  if(state.streak>=7) unlockBadge('week_streak');
  if(Object.keys(state.scratched).length>=1) unlockBadge('first_scratch');
  if(Object.keys(state.moods).length>=1) unlockBadge('mood_logged');
  if(Object.values(state.moods).some(v=>v<=2)) unlockBadge('storm_walker');
  if(state.gratitude.length>=5) unlockBadge('gratitude_5');
  if(state.letters.length>=1) unlockBadge('letter_written');
  if((state.water[todayKey()]||0) >= state.waterGoal) unlockBadge('water_goal');
  if(Object.keys(state.sleep).length>=1) unlockBadge('sleep_logged');
  updateCounts();
}
function updateCounts(){
  document.getElementById('badgeCountHome').textContent = state.unlockedBadges.length+'/'+BADGES.length;
  document.getElementById('coinCount').textContent = state.coins;
  document.getElementById('streakCount').textContent = state.streak;
  document.getElementById('waterCountHome').textContent = (state.water[todayKey()]||0)+'/'+state.waterGoal;
}

/* ============ HOME ============ */
const AFFIRMATIONS = [
  {t:"You don't have to have it all figured out today.", tags:['stress','anxiety']},
  {t:"Showing up half-hearted still counts as showing up.", tags:['low_mood']},
  {t:"This feeling is real, but it is not permanent.", tags:['anxiety','low_mood']},
  {t:"You're allowed to rest without earning it first.", tags:['stress','sleep']},
  {t:"One small step counts more than a perfect plan.", tags:['stress']},
  {t:"You are not behind. You are exactly on your own timeline.", tags:['low_mood','just_curious']},
  {t:"It's okay to need a minute. Take it.", tags:['anxiety','stress']},
  {t:"You've made it through every hard day so far.", tags:['low_mood','loneliness']},
  {t:"You are not alone in this, even when it feels quiet.", tags:['loneliness']},
  {t:"Reaching out is a sign of strength, not weakness.", tags:['loneliness']},
  {t:"Your mind deserves rest as much as your body does.", tags:['sleep']},
  {t:"A racing mind doesn't mean something is wrong with you.", tags:['anxiety']}
];
let currentAffirmation = AFFIRMATIONS[0].t;
function pickAffirmation(){
  const tagged = state.reasons && state.reasons.length
    ? AFFIRMATIONS.filter(a => a.tags.some(tag => state.reasons.includes(tag)))
    : [];
  const pool = tagged.length ? tagged : AFFIRMATIONS;
  return pool[Math.floor(Math.random()*pool.length)].t;
}

function renderHome(){
  const hour = new Date().getHours();
  document.getElementById('greetTime').textContent = hour<12?'Good morning':hour<18?'Good afternoon':'Good evening';
  document.getElementById('greetName').textContent = 'Hi, ' + (state.name || 'friend');

  const stepsToday = state.steps[todayKey()]||0;
  document.getElementById('stepsToday').textContent = stepsToday.toLocaleString();
