<script>
/* ============ STATE ============ */
const todayKey = () => new Date().toISOString().slice(0,10);
const DEFAULT_STATE = {
  name:null, onboarded:false, reasons:[],
  goalSteps:6000, waterGoal:8,
  steps:{}, moods:{}, scratched:{}, water:{}, sleep:{},
  coins:0, streak:0, lastActiveDate:null,
  unlockedBadges:[], breathSessions:0,
  gratitude:[], letters:[], savedAffirmations:[],
  reminders:{morning:false, evening:false},
  weeklyDigestScheduled:false,
  updatedAt:0
};
function loadState(){
  try{ const raw=localStorage.getItem('anchor_state_v2'); if(!raw) return structuredClone(DEFAULT_STATE);
    return Object.assign(structuredClone(DEFAULT_STATE), JSON.parse(raw)); }
  catch(e){ return structuredClone(DEFAULT_STATE); }
}
function saveState(){
  state.updatedAt = Date.now();
  localStorage.setItem('anchor_state_v2', JSON.stringify(state));
  queueCloudSync();
}
let state = loadState();

const BADGES = [
  {id:'first_breath', icon:'🫁', name:'Breath Taker', cond:'1 breathing session'},
  {id:'five_breaths', icon:'🌊', name:'Steady Tide', cond:'5 breathing sessions'},
  {id:'first_scratch', icon:'🪙', name:'Coin Collector', cond:'Open a scratch card'},
  {id:'week_streak', icon:'🔥', name:'Consistency Gremlin', cond:'7-day streak'},
  {id:'goal_hit', icon:'🚶', name:'Step Sprite', cond:'Hit your step goal'},
  {id:'goal_hit_5', icon:'🏔️', name:'Trail Blazer', cond:'Hit goal 5 times'},
  {id:'mood_logged', icon:'💭', name:'Honest Heart', cond:'Log your mood'},
  {id:'storm_walker', icon:'⛈️', name:'Storm Walker', cond:'Log mood on a hard day'},
  {id:'first_vent', icon:'📝', name:'Weight Lifted', cond:'Release a vent'},
  {id:'gratitude_5', icon:'🫙', name:'Jar Keeper', cond:'5 gratitude drops'},
  {id:'letter_written', icon:'✉️', name:'Time Traveler', cond:'Write a future letter'},
  {id:'water_goal', icon:'💧', name:'Well Watered', cond:'Hit water goal'},
  {id:'sleep_logged', icon:'🌙', name:'Rest Keeper', cond:'Log your sleep'},
  {id:'grounding_done', icon:'🌳', name:'Rooted', cond:'Finish a grounding exercise'},
];

/* ============ NATIVE HELPERS ============ */
function isNative(){ return !!(window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform()); }
function nativePlugin(name){ return (window.Capacitor && window.Capacitor.Plugins) ? window.Capacitor.Plugins[name] : null; }

/* ============ STEP TRACKING (accelerometer peak-detection) ============ */
// Uses the official @capacitor/motion plugin. This is a simple, on-device step
// estimate (not a dedicated step-counter sensor) — good enough to make the
// steps ring real, but treat the numbers as approximate.
let stepAccelBuffer = [];
let lastStepTime = 0;

async function initStepTracking(){
  const Motion = nativePlugin('Motion');
  if(!isNative() || !Motion){ return; } // browser preview / plugin missing -> manual button stays
  try{
    await Motion.addListener('accel', handleAccelEvent);
    document.getElementById('manualStepHint').style.display = 'none';
    document.getElementById('autoStepHint').style.display = 'block';
  }catch(e){ console.warn('Anchor: motion sensor unavailable, using manual step logging.', e); }
}
function handleAccelEvent(event){
  const a = event.accelerationIncludingGravity || event.acceleration;
  if(!a) return;
  const mag = Math.sqrt((a.x||0)**2 + (a.y||0)**2 + (a.z||0)**2);
  stepAccelBuffer.push(mag);
  if(stepAccelBuffer.length > 6) stepAccelBuffer.shift();
  const avg = stepAccelBuffer.reduce((s,v)=>s+v,0)/stepAccelBuffer.length;
  const now = Date.now();
  if(mag - avg > 1.4 && now - lastStepTime > 300){
    lastStepTime = now;
    const today = todayKey();
    state.steps[today] = (state.steps[today]||0) + 1;
    saveState();
    if(document.getElementById('screen-home').classList.contains('active')) renderHome();
  }
}

/* ============ LOCAL NOTIFICATIONS (reminders + weekly digest) ============ */
const NOTIF_IDS = { morning: 101, evening: 102, weekly: 103 };
async function ensureNotifPermission(){
  const LN = nativePlugin('LocalNotifications');
  if(!LN) return false;
  try{
    const perm = await LN.checkPermissions();
    if(perm.display !== 'granted'){
      const req = await LN.requestPermissions();
      return req.display === 'granted';
    }
    return true;
  }catch(e){ return false; }
}
async function scheduleReminder(which){
  const LN = nativePlugin('LocalNotifications');
  if(!LN) { showToast('Reminders need the installed app, not the browser preview'); return; }
  const ok = await ensureNotifPermission();
  if(!ok){ showToast('Notification permission was not granted'); return; }
  const hour = which === 'morning' ? 9 : 21;
  const title = which === 'morning' ? 'Good morning 🌅' : 'Wind down 🌙';
  const body = which === 'morning' ? 'A quiet minute before the day starts?' : 'How are you feeling as today wraps up?';
  await LN.schedule({ notifications: [{
    id: NOTIF_IDS[which], title, body,
    schedule: { on: { hour, minute: 0 }, repeats: true, allowWhileIdle: true }
  }]});
}
async function cancelReminder(which){
  const LN = nativePlugin('LocalNotifications');
  if(!LN) return;
  await LN.cancel({ notifications: [{ id: NOTIF_IDS[which] }] });
}
async function scheduleWeeklyDigest(){
  const LN = nativePlugin('LocalNotifications');
  if(!LN || state.weeklyDigestScheduled) return;
  const ok = await ensureNotifPermission();
  if(!ok) return;
  try{
    await LN.schedule({ notifications: [{
      id: NOTIF_IDS.weekly,
      title: 'Your week, gently summed up 🌿',
      body: 'Your reflection is ready in the Progress tab.',
      schedule: { on: { weekday: 1, hour: 18, minute: 0 }, repeats: true, allowWhileIdle: true }
    }]});
    state.weeklyDigestScheduled = true;
    saveState();
  }catch(e){ /* silent, non-critical */ }
}

/* ============ SHARE A BADGE ============ */
async function shareBadge(badgeId){
  const b = BADGES.find(x=>x.id===badgeId);
  if(!b) return;
  const text = `I just earned "${b.icon} ${b.name}" on Anchor — ${b.cond}. Small steps count. 🌿`;
  const ShareApi = nativePlugin('Share');
  try{
    if(ShareApi){
      await ShareApi.share({ title: 'Anchor badge', text, dialogTitle: 'Share your badge' });
    } else if(navigator.share){
      await navigator.share({ title: 'Anchor badge', text });
    } else if(navigator.clipboard){
      await navigator.clipboard.writeText(text);
      showToast('Copied to clipboard 📋');
    }
  }catch(e){ /* user cancelled share sheet, ignore */ }
}

/* ============ CLOUD SYNC (Supabase) ============ */
// Fill these in from your own Supabase project: Settings -> API
// Leave as-is to run in local-only mode (everything still works, just device-only).
const SUPABASE_URL = 'YOUR_SUPABASE_URL';
const SUPABASE_ANON_KEY = 'YOUR_SUPABASE_ANON_KEY';

let sb = null;
let cloudUser = null;
let cloudReady = false;
let syncTimeout = null;

function cloudConfigured(){
  return SUPABASE_URL && SUPABASE_URL.startsWith('http') && SUPABASE_ANON_KEY && SUPABASE_ANON_KEY.length > 20;
}

async function initCloud(){
  if(!cloudConfigured() || typeof supabase === 'undefined'){
    console.log('Anchor: running local-only (no Supabase configured).');
    return;
  }
  try{
    sb = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    let { data: { session } } = await sb.auth.getSession();
    if(!session){
      const { data, error } = await sb.auth.signInAnonymously();
      if(error) throw error;
      session = data.session;
    }
    cloudUser = session.user;
    cloudReady = true;
    await pullCloudState();
    fetchCommunityStats();
  }catch(e){
    console.warn('Anchor cloud init failed, staying local-only:', e.message);
    cloudReady = false;
  }
}

async function pullCloudState(){
  if(!cloudReady) return;
  const { data, error } = await sb.from('user_data').select('state, updated_at').eq('id', cloudUser.id).maybeSingle();
  if(error){ console.warn('pullCloudState error', error.message); return; }
  if(data && data.state){
    const remoteUpdated = new Date(data.updated_at).getTime();
    if(remoteUpdated > (state.updatedAt||0)){
      state = Object.assign(structuredClone(DEFAULT_STATE), data.state);
      localStorage.setItem('anchor_state_v2', JSON.stringify(state));
      renderHome();
    }
  } else {
    pushCloudState();
  }
}

function queueCloudSync(){
  if(!cloudReady) return;
  clearTimeout(syncTimeout);
  syncTimeout = setTimeout(pushCloudState, 1500);
}
async function pushCloudState(){
  if(!cloudReady) return;
  try{
    await sb.from('user_data').upsert({ id: cloudUser.id, state: state, updated_at: new Date().toISOString() });
  }catch(e){ console.warn('pushCloudState failed', e.message); }
}

async function incrementCommunityStat(column){
  if(!cloudReady) return;
  try{ await sb.rpc('increment_stat', { stat_column: column }); }catch(e){ /* silent */ }
}

async function fetchCommunityStats(){
  if(!cloudReady) return;
  try{
    const today = todayKey();
    const { data } = await sb.from('community_stats').select('*').eq('day', today).maybeSingle();
    if(data){
      const el = document.getElementById('communityStatText');
      if(el) el.textContent = `${(data.scratch_opens||0).toLocaleString()} people opened their scratch card today. ${(data.breath_sessions||0).toLocaleString()} took a breathing break.`;
    }
  }catch(e){ /* silent */ }
}

/* ============ ONBOARDING ============ */
let pendingReasons = [];
function goOnboardStep2(){
  document.getElementById('onboardStep1').style.display = 'none';
  document.getElementById('onboardStep2').style.display = 'block';
}
