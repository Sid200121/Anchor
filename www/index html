/* ============ SOUNDS (Web Audio, no external assets) ============ */
let audioCtx=null, activeSoundNodes={}, currentVolume=0.4;
function ensureAudioCtx(){ if(!audioCtx) audioCtx = new (window.AudioContext||window.webkitAudioContext)(); }
function makeNoiseBuffer(){
  const bufferSize = 2*audioCtx.sampleRate;
  const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
  const data = buffer.getChannelData(0);
  for(let i=0;i<bufferSize;i++) data[i] = Math.random()*2-1;
  return buffer;
}
function toggleSound(name){
  ensureAudioCtx();
  document.querySelectorAll('.sound-card').forEach(c=>{ if(c.dataset.sound!==name) c.classList.remove('playing'); });
  const card = document.querySelector(`.sound-card[data-sound="${name}"]`);
  if(activeSoundNodes[name]){
    activeSoundNodes[name].stop(); delete activeSoundNodes[name];
    card.classList.remove('playing');
    return;
  }
  Object.keys(activeSoundNodes).forEach(k=>{ activeSoundNodes[k].stop(); delete activeSoundNodes[k]; });
  const src = audioCtx.createBufferSource();
  src.buffer = makeNoiseBuffer(); src.loop = true;
  const filter = audioCtx.createBiquadFilter();
  const gain = audioCtx.createGain(); gain.gain.value = currentVolume*0.25;
  if(name==='rain'){ filter.type='highpass'; filter.frequency.value=800; }
  else if(name==='noise'){ filter.type='lowpass'; filter.frequency.value=4000; }
  else if(name==='waves'){ filter.type='lowpass'; filter.frequency.value=400; }
  else { filter.type='lowpass'; filter.frequency.value=150; }
  src.connect(filter).connect(gain).connect(audioCtx.destination);
  src.start();
  activeSoundNodes[name] = src;
  card.classList.add('playing');
}
function setVolume(v){ currentVolume = v/100; }

/* ============ SCRATCH ============ */
const SCRATCH_MESSAGES = [
  "You showed up today. That counts.",
  "Somewhere, someone is glad you exist.",
  "It's okay to move slowly today.",
  "You've survived every hard day so far.",
  "Small steps still move you forward.",
  "You are allowed to take up space.",
  "This moment is temporary — you're not.",
  "Be as kind to yourself as you are to others."
];
function renderScratch(){
  const today=todayKey(), canvas=document.getElementById('scratchCanvas'), frame=canvas.parentElement;
  const done = !!state.scratched[today];
  document.getElementById('scratchHint').style.display = done?'none':'block';
  document.getElementById('scratchDoneMsg').style.display = done?'block':'none';
  if(done){ canvas.style.display='none'; document.getElementById('scratchMessage').textContent = state.scratched[today].message; return; }
  canvas.style.display='block';
  const rect = frame.getBoundingClientRect();
  canvas.width=rect.width; canvas.height=rect.height;
  const ctx = canvas.getContext('2d');
  const grad = ctx.createLinearGradient(0,0,canvas.width,canvas.height);
  grad.addColorStop(0,'#382F58'); grad.addColorStop(1,'#211D33');
  ctx.fillStyle=grad; ctx.fillRect(0,0,canvas.width,canvas.height);
  ctx.fillStyle='rgba(240,184,110,0.8)'; ctx.font='700 14px Inter, sans-serif'; ctx.textAlign='center';
  ctx.fillText('✦ scratch here ✦', canvas.width/2, canvas.height/2);
  let scratching=false;
  function getPos(e){ const r=canvas.getBoundingClientRect(); const cx=e.touches?e.touches[0].clientX:e.clientX; const cy=e.touches?e.touches[0].clientY:e.clientY; return {x:cx-r.left, y:cy-r.top}; }
  function scratchAt(x,y){ ctx.globalCompositeOperation='destination-out'; ctx.beginPath(); ctx.arc(x,y,26,0,Math.PI*2); ctx.fill(); }
  function checkComplete(){
    const d = ctx.getImageData(0,0,canvas.width,canvas.height).data;
    let cleared=0, total=0;
    for(let i=3;i<d.length;i+=40){ total++; if(d[i]===0) cleared++; }
    if(cleared/total>0.55) finish();
  }
  function finish(){
    const msg = SCRATCH_MESSAGES[Math.floor(Math.random()*SCRATCH_MESSAGES.length)];
    state.scratched[today]={message:msg}; state.coins+=1; saveState(); unlockBadge('first_scratch'); checkBadges();
    incrementCommunityStat('scratch_opens');
    canvas.style.transition='opacity 0.4s ease'; canvas.style.opacity='0';
    setTimeout(()=>{ document.getElementById('scratchMessage').textContent=msg; renderScratch(); },400);
    showToast('+1 coin 🪙');
  }
  const start=(e)=>{ scratching=true; const p=getPos(e); scratchAt(p.x,p.y); };
  const move=(e)=>{ if(!scratching) return; e.preventDefault(); const p=getPos(e); scratchAt(p.x,p.y); checkComplete(); };
  const end=()=>{ scratching=false; };
  canvas.addEventListener('mousedown',start); canvas.addEventListener('mousemove',move); window.addEventListener('mouseup',end);
  canvas.addEventListener('touchstart',start,{passive:true}); canvas.addEventListener('touchmove',move,{passive:false}); canvas.addEventListener('touchend',end);
}

